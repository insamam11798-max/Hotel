# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hotelpulse"
APP_URL="https://app.yourdomain.com"
# 32+ random bytes each, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
APP_ENCRYPTION_KEY=""
BENCHMARK_HASH_SECRET=""   # never change after launch: it anonymises benchmark contributions
CRON_SECRET=""             # Bearer token for /api/jobs/run

# ── Storage (local disk for dev, S3-compatible in production) ──────────────
STORAGE_DRIVER="s3"        # local | s3
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""             # optional (R2/MinIO); defaults to AWS
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── AI (optional — HotelPulse works without an LLM) ───────────────────────
AI_PROVIDER="auto"         # auto | anthropic | openai | builtin
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""         # default: claude-opus-5-5
OPENAI_API_KEY=""
OPENAI_MODEL=""

# ── Email (optional — without it emails are logged to the admin outbox) ──
RESEND_API_KEY=""
EMAIL_FROM="HotelPulse <no-reply@yourdomain.com>"

# ── Billing (optional — without it the manual/invoice provider is used) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Seeding ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD=""     # required when NODE_ENV=production
SEED_DEMO="true"           # set false to skip the demo organization

# Live review data (official APIs; optional)
GOOGLE_PLACES_API_KEY=""
TRIPADVISOR_API_KEY=""
